{
  "name": "ap-gis-grid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive GIS + MIS lookup for the AP-TRANSCO transmission network (400/220/132 kV lines and substations).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:data": "tsx scripts/build-data.mts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "sync:live": "tsx scripts/sync-live.mts",
    "build:ref": "tsx scripts/build-ref-layers.mts",
    "update": "bash scripts/update.sh",
    "sync:towers": "tsx scripts/sync-towers.mts",
    "sync:network": "tsx scripts/sync-network.mts",
    "e2e": "PLAYWRIGHT_BROWSERS_PATH=0 playwright test",
    "e2e:install": "PLAYWRIGHT_BROWSERS_PATH=0 playwright install chromium"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.21.3",
    "maplibre-gl": "^5.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/vite": "^4.1.7",
    "@tmcw/togeojson": "^7.1.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/shapefile": "^0.6.4",
    "@vitejs/plugin-react": "^4.4.1",
    "@xmldom/xmldom": "^0.9.8",
    "mapshaper": "^0.6.121",
    "node-html-parser": "^7.0.1",
    "shapefile": "^0.6.6",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vite": "^7.0.0",
    "vitest": "^3.1.4"
  }
}
