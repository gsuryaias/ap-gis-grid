{
  "name": "ap-gis-grid",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Interactive GIS + MIS lookup for the AP-TRANSCO transmission network (400/220/132 kV lines and substations).",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "build:data": "tsx scripts/build-data.mts",
    "pipeline:psp": "NODE_EXTRA_CA_CERTS=pipelines/certs/extra-cas.pem tsx pipelines/psp-daily.mts",
    "pipeline:psp-frequency": "NODE_EXTRA_CA_CERTS=pipelines/certs/extra-cas.pem tsx pipelines/psp-frequency.mts",
    "pipeline:vidyut": "NODE_EXTRA_CA_CERTS=pipelines/certs/extra-cas.pem tsx pipelines/vidyut-daily.mts",
    "pipeline:vidyut-blocks": "NODE_EXTRA_CA_CERTS=pipelines/certs/extra-cas.pem tsx pipelines/vidyut-blocks.mts",
    "pipeline:cea": "NODE_EXTRA_CA_CERTS=pipelines/certs/extra-cas.pem tsx pipelines/cea-monthly.mts",
    "pipelines": "npm run pipeline:psp && npm run pipeline:psp-frequency && npm run pipeline:vidyut && npm run pipeline:vidyut-blocks && npm run pipeline:cea",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "^1.33.1-dev45.0",
    "@tanstack/react-table": "^8.21.3",
    "echarts": "^6.1.0",
    "maplibre-gl": "^5.8.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zustand": "^5.0.5"
  },
  "devDependencies": {
    "@duckdb/node-api": "^1.5.3-r.3",
    "@tailwindcss/vite": "^4.1.7",
    "@tmcw/togeojson": "^7.1.2",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^24.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/shapefile": "^0.6.4",
    "@vitejs/plugin-react": "^4.4.1",
    "@xmldom/xmldom": "^0.9.8",
    "node-html-parser": "^7.0.1",
    "shapefile": "^0.6.6",
    "tailwindcss": "^4.1.7",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "undici": "^7.27.2",
    "vite": "^7.0.0",
    "vitest": "^3.1.4",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
